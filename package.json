{
  "name": "dse-solar-system-viewer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run generate:runtime && npm run generate:diagram-layouts && npm run generate:receipts",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run generate:runtime && npm run generate:diagram-layouts && npm run generate:receipts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "prebuild:pages": "npm run generate:runtime && npm run generate:diagram-layouts && npm run generate:receipts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "benchmark:routing": "tsx scripts/benchmark-routing.ts",
    "generate:runtime": "tsx scripts/generate-runtime.ts",
    "generate:diagram-layouts": "tsx scripts/generate-diagram-layouts.ts",
    "generate:receipts": "node scripts/generate-public-receipt-manifest.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
